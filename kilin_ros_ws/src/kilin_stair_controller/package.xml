<?xml version="1.0"?>
<package format="3">
  <name>kilin_stair_controller</name>
  <version>0.1.0</version>
  <description>Coordinated CSV gait and Kinova pose controller for Kilin stair climbing.</description>
  <maintainer email="ian20030201@gmail.com">ian920201</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>kilin_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>kinova_ptp_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>

  <build_depend>libgpiod-dev</build_depend>
  <exec_depend>libgpiod2</exec_depend>
  <exec_depend>kinova_joint_ptp</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
